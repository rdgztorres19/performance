# ============================================================================
# Performance demo switches.
#
# Everything is DISABLED by default. Set a topic to true and run:
#     ./run.sh up
# Only the topics set to true are created and started.
#
# Each enabled topic starts up to 4 containers:
#     <topic>-py-incorrect   <topic>-py-correct
#     <topic>-js-incorrect   <topic>-js-correct
# so you can compare the bad and the good implementation side by side.
# ============================================================================

# ---------------------------------------------------------------------------
# Global settings
# ---------------------------------------------------------------------------

# How long each long-running demo runs, in seconds.
# The scripts default to 300 (5 minutes); 20 keeps a full run short.
DURATION_SEC=20

# Which languages to start for an enabled topic.
# Set one to false to compare only the others.
#
# C exists only for the 12 low-level topics (branch prediction, false sharing,
# cache layout, memory ordering, and friends). Python and JavaScript cannot
# demonstrate those: the interpreter, the GIL, and the garbage collector hide
# the hardware effect. Where a topic has C, it is the version that actually
# proves the point.
RUN_PYTHON=true
RUN_NODE=true
RUN_C=true

# Which variants to start. Keeping both is the point of the comparison.
RUN_INCORRECT=true
RUN_CORRECT=true

# Per-container limits. Several demos are about CPU contention, so pinning
# the container to a small, fixed number of cores makes runs comparable.
#
# NOTE: the multi-core C topics (06-false-sharing, 11-lock-contention,
# 01-context-switching, 25-thread-affinity) need real parallelism to show the
# effect. Measured on 06-false-sharing: CPU_LIMIT=2 gives only 1.1x, while
# CPU_LIMIT=8 gives 1.8x. Raise this to at least 8 when running those.
CPU_LIMIT=2
MEMORY_LIMIT=1g

# ---------------------------------------------------------------------------
# Topics (true = create and run it, false = skip it entirely)
# ---------------------------------------------------------------------------

# --- CPU and scheduling ---
ENABLE_01_CONTEXT_SWITCHING=false           # 01-context-switching  [python, node]
ENABLE_02_BUSY_WAIT=false                   # 02-busy-wait  [python, node]
ENABLE_05_BRANCH_MISPREDICTION=false        # 05-branch-misprediction  [python, node]
ENABLE_06_FALSE_SHARING=false               # 06-false-sharing  [python, node]
ENABLE_11_LOCK_CONTENTION=false             # 11-lock-contention  [python, node]
ENABLE_23_THREAD_POOLS=false                # 23-thread-pools  [python, node]
ENABLE_25_THREAD_AFFINITY=false             # 25-thread-affinity  [python]
ENABLE_29_MEMORY_BARRIERS=false             # 29-memory-barriers  [python, node]
ENABLE_34_THREAD_POOL_SIZING=false          # 34-thread-pool-sizing  [python]

# --- Memory ---
ENABLE_04_MEMORY_ALLOCATION=false           # 04-memory-allocation  [python, node]
ENABLE_13_MEMORY_POOLING=false              # 13-memory-pooling  [python, node]
ENABLE_14_HEAP_FRAGMENTATION=false          # 14-heap-fragmentation  [python]
ENABLE_15_MEMORY_ACCESS_PATTERNS=false      # 15-memory-access-patterns  [python, node]
ENABLE_24_MEMORY_MAPPED_IO=false            # 24-memory-mapped-io  [python]
ENABLE_26_PAGE_FAULTS=false                 # 26-page-faults  [python]
ENABLE_27_ZERO_COPY=false                   # 27-zero-copy  [python, node]
ENABLE_28_CACHE_FRIENDLY_LAYOUTS=false      # 28-cache-friendly-layouts  [python, node]

# --- Disk and file I/O ---
ENABLE_09_RANDOM_IO=false                   # 09-random-io  [python, node]
ENABLE_12_MANY_SMALL_FILES=false            # 12-many-small-files  [python, node]
ENABLE_16_WRITE_BATCHING=false              # 16-write-batching  [python]
ENABLE_17_APPEND_ONLY=false                 # 17-append-only  [python]
ENABLE_18_AVOID_FSYNC=false                 # 18-avoid-fsync  [python]
ENABLE_19_PREALLOCATE_FILE=false            # 19-preallocate-file  [python]
ENABLE_20_STREAM_FILES=false                # 20-stream-files  [python]
ENABLE_21_IO_CHUNK_SIZES=false              # 21-io-chunk-sizes  [python]
ENABLE_22_FILE_LOCKS=false                  # 22-file-locks  [python]
ENABLE_30_COMPRESSION_TRADEOFF=false        # 30-compression-tradeoff  [python]
ENABLE_31_FILESYSTEM_METADATA=false         # 31-filesystem-metadata  [python]
ENABLE_32_BUFFERED_STREAMS=false            # 32-buffered-streams  [python]
ENABLE_33_BULK_IO=false                     # 33-bulk-io  [python]

# --- Application-level patterns ---
ENABLE_03_PER_ITEM_BATCHING=false           # 03-per-item-batching  [python, node]
ENABLE_07_EXCEPTIONS_CONTROL_FLOW=false     # 07-exceptions-control-flow  [python, node]
ENABLE_08_CLOSURES_ALLOCATIONS=false        # 08-closures-allocations  [python, node]
ENABLE_10_BLOCKING_IO=false                 # 10-blocking-io  [python, node]
ENABLE_35_CANCELLATION_TOKENS=false         # 35-cancellation-tokens  [python]
ENABLE_36_THROTTLING_RATE_LIMITING=false    # 36-throttling-rate-limiting  [python]

# --- Networking ---
ENABLE_37_CONNECTION_POOLING=false          # 37-connection-pooling  [python]
ENABLE_38_BATCH_NETWORK=false               # 38-batch-network  [python]
ENABLE_39_BINARY_PROTOCOLS=false            # 39-binary-protocols  [python]
